+async function exportInstalledPresets(){
+ const directory=$('#library-directory')?.value.trim()||'',button=$('#library-presets-export');
+ if(!librarySave?.id)return;
+ if(!directory){toast('请填写或选择导出目录');return}
+ if(button){button.disabled=true;button.textContent='正在导出中…'}
+ try{
+  const result=await api('/api/save/installed-presets-export',{id:librarySave.id,directory});
+  localStorage.setItem('fm27-export-directory',directory);
+  libraryExport=result;libraryRefresh();
+  toast('已导出安装内原装预设 '+(result.files?.length||0)+' 套到 '+(result.directory||directory)+(result.failures?.length?'，失败 '+result.failures.length+' 项':''));
+ }catch(e){toast('导出原装预设失败：'+e.message);if($('#library-presets-export')){$('#library-presets-export').disabled=false;$('#library-presets-export').textContent='导出全部安装内原装预设'}}
